# ---------------------------------------------------------------
# Rashi Ratan — environment variables (prototype / Razorpay TEST)
# Copy this file to `.env.local` and fill in your own TEST keys.
# ---------------------------------------------------------------

# Public key id — safe to expose to the browser (used by Razorpay Checkout)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# SECRET — server only. NEVER prefix with NEXT_PUBLIC_, never import in a
# client component. Used by /app/api/razorpay/* route handlers only.
RAZORPAY_KEY_SECRET=your_test_secret_here

# When no keys are present the app automatically runs in MOCK mode:
# the checkout simulates a successful payment so the demo flow still works.

# ---------------------------------------------------------------
# Astrology chatbot (optional)
# ---------------------------------------------------------------
# Server only. With a key the chat widget answers with Claude; without one
# it falls back to the built-in rule-based assistant, so it always works.
ANTHROPIC_API_KEY=
